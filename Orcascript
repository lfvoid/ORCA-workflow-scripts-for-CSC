#!/bin/bash
#Command: Orcascript filename.inp

#############################################################################################
# Script for running a series of ORCA input files either in serial or in parallell.
# Only works on the supercomputer ROIHU.
#############################################################################################

orcadir="/projappl/kurten/appl_public/orca_6_1_1_linux_x86-64_shared_openmpi418_avx2"
acc="kurten"

f=$(echo $1)
FILE=`echo "$f" | cut -d'.' -f1` 
echo "Give value for time (hh:mm:ss)"
read TIME
echo "How many computing cores? (384 per node for small & 64 for hugemem)"
read CORES
echo "Memory per core?"
read MEM
echo "Select the partition: small, large, test, etc..."
read QUEUE
# Nino's project does not have access to Roihu
#echo "Use Nino's project? y/n"
#read Nino
#if [ "$Nino" = "y" ]; then
#acc="project_2006383"
#fi

SDIR=`pwd`

# Create .job file
echo "#!/bin/bash -l
#SBATCH -J $FILE
#SBATCH -t $TIME
#SBATCH --ntasks-per-node $CORES
#SBATCH --nodes 1
#SBATCH --account=$acc
#SBATCH --mem-per-cpu=$MEM
#SBATCH -p $QUEUE

export ORCADIR=$orcadir
module purge
module load orca/6.1.1

\$ORCADIR/orca $FILE.inp > $FILE.out

seff \$SLURM_JOBID
" > $FILE.job

sbatch $FILE.job
