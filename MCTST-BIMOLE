#!/bin/bash
#############################################################################################
# Script for Multi-Conformer Transition State Theory Calculations with Temperature Dependence
# This version is for BIMOLECULAR REACTIONS, with DFT energies for IRC endpoints.
# by Lauri Franzon
#############################################################################################

##################################################################################################
# Note: These TST scripts are built on the assumption that output files have the naming convention
# PrefixN-DFTsuffix.out or PrefixN-DFTsuffix-CCSD(T)suffix.out
# Where N is an integer. This is crucial for the code's recognition of which file is which.
##################################################################################################

# For other users: Change this variable name to the location of your python scripts.
snakepit="/users/lfranzon/ORCA_Workflow_Scripts/Snakepit"

echo "NOTE: Linear reactants like O2 or OH are currently not supported!"

echo "Your files:"
ls

echo "CCSD(T) file name extension? e.g. DLPNO or F12?"
read ccname

#########################################################################################
# STEP 1: Extract Coupled-Cluster energy corrections from reactant, TS, and Product files.
##########################################################################################

echo "Name of GLOBAL MINIMUM Coupled-Cluster output file for REACTANT 1"
read RCC1

# Extract Coupled Cluster energy
REe1=$(grep "FINAL SINGLE POINT ENERGY" $RCC1.out | awk '{print $5}')

# Extract DFT electronic energy for the same conformer.
REedft1=$(grep "FINAL SINGLE POINT ENERGY" ${RCC1%-$ccname}.out | awk '{print $5}' | tail -1 )

# Extract mass of reactant 1.
R1mass=$(grep "Total Mass" ${RCC1%-$ccname}.out | awk '{print $4}')

echo "Name of GLOBAL MINIMUM Coupled-Cluster output file for REACTANT 2"
read RCC2

# Extract Coupled Cluster energy
REe2=$(grep "FINAL SINGLE POINT ENERGY" $RCC2.out | awk '{print $5}')

# Extract DFT electronic energy for the same conformer.
REedft2=$(grep "FINAL SINGLE POINT ENERGY" ${RCC2%-$ccname}.out | awk '{print $5}' | tail -1 )

# Extract mass of reactant 2.
R2mass=$(grep "Total Mass" ${RCC2%-$ccname}.out | awk '{print $4}')

echo "Name of TRANSITION STATE Coupled-Cluster output file"
read TSCC

# Extract Coupled Cluster energy
TSEe=$(grep "FINAL SINGLE POINT ENERGY" $TSCC.out | awk '{print $5}')

# Extract DFT electronic energy for the same conformer.
TSEedft=$(grep "FINAL SINGLE POINT ENERGY" ${TSCC%-$ccname}.out | awk '{print $5}' | tail -1 )

echo "Include tunneling correction? y/n"
read tunnel
if [ "$tunnel" == "y" ]; then

echo "Name of PRODUCT Opt/Freq file"
read PwB

echo "IRC Reactant complex Opt/Freq output?"
read IRCR
fi

#####################################################################
#STEP 2: Count the R & TS conformers and extract necessary variables.
#####################################################################

echo "DFT Opt+Freq output file name ending? (for example DFT or wB)"
read suffix

# Count the number of vibrational modes for each system.
nov1=$( grep "total number of vibrations considered is" ${RCC1%-$ccname}.out | tail -1 | awk '{print $8}' )
# Number of lines to grep from ORCA vibrational output
let "lines1=nov1+1"

nov2=$( grep "total number of vibrations considered is" ${RCC2%-$ccname}.out | tail -1 | awk '{print $8}' )
let "lines2=nov2+1"

# Count the number of vibrational modes from a reactant optimization file.
nov=$( grep "total number of vibrations considered is" ${TSCC%-$ccname}.out | tail -1 | awk '{print $8}' )
let "Plines=nov+1"
let "TSlines=nov+7"    # A slightly different Frequency extraction command is needed to include the negative frequency.

# Write the columns headers for the Reactant conformer DataFrame.
(echo -n "n Energy ZPE Gibbs Dip A B C" 
for (( i=1; i<=$nov1; i++ ))
do
    echo -n " v$i"
done
echo ) > Reactant1_conformers.txt

echo "Base name of REACTANT 1 final conformer optimization (e.g. Criegee...suffix.out)"
read ROPT1

# Count the number of reactant conformers.
# NOTE FOR OTHER USERS: The assumption here is that all final DFT optimization outputs are named ...wB.out after wB97X-D3. This is my convention. Feel free to change it if necessary,
# but note that the line below must exclusively count the DFT optimization output files. 
Rnum=$(ls $ROPT1*$suffix.out | wc -l)
echo "$Rnum reactant conformers"

# Loop over the output files.
k=0
for r in $ROPT1*$suffix.out; do
        k=$((k+1))
        # Exctract DFT energy.
        ener=$(grep 'FINAL SINGLE POINT ENERGY' $r | tail -1 | awk '{printf "%.7f",$5}')
        # Extract the Zero-point energy
        zpe=$(grep 'Zero point energy' $r | tail -1 | awk '{print $5}')
        # Extract Gibbs free energy at 298.15 K (for determining global minimum reactant)
        gibbs=$(grep "Final Gibbs free energy" $r | tail -1 | awk '{print $6}')
        # Extract dipole moment
        dipole=$(grep "Magnitude (Debye)" $r | awk '{print $4}')
        # Extract rotational constants.
        rots=$(grep "Rotational constants in cm-1:" $r | tail -1 | awk '{print $5,$6,$7}' | xargs | tr ' ' ' ')
        # Extract vibrational frequencies.
        vibs=$(grep "All vibrations are strictly harmonic" -A$lines1 $r | tail -$nov1 | awk '{print $2}' | xargs | tr ' ' ' ')
        # Save info in text file.
        ( echo "$k $ener $zpe $gibbs $dipole $rots $vibs" ) >> Reactant1_conformers.txt
done

echo "Base name of REACTANT 2 final conformer optimization (e.g. Acid...suffix.out)"
read ROPT2

# Write the columns headers for the Reactant conformer DataFrame.
(echo -n "n Energy ZPE Gibbs Dip A B C"
for (( i=1; i<=$nov2; i++ ))
do
    echo -n " v$i"
done
echo ) > Reactant2_conformers.txt

Rnum=$(ls $ROPT2*$suffix.out | wc -l)
echo "$Rnum reactant conformers"

# Loop over the output files.
k=0
for r in $ROPT2*$suffix.out; do
        k=$((k+1))
        # Exctract DFT energy.
        ener=$(grep 'FINAL SINGLE POINT ENERGY' $r | tail -1 | awk '{printf "%.7f",$5}')
        # Extract the Zero-point energy
        zpe=$(grep 'Zero point energy' $r | tail -1 | awk '{print $5}')
        # Extract Gibbs free energy at 298.15 K (for determining global minimum reactant)
        gibbs=$(grep "Final Gibbs free energy" $r | tail -1 | awk '{print $6}')
        # Extract dipole moment
        dipole=$(grep "Magnitude (Debye)" $r | awk '{print $4}')
        # Extract rotational constants.
        rots=$(grep "Rotational constants in cm-1:" $r | tail -1 | awk '{print $5,$6,$7}' | xargs | tr ' ' ' ')
        # Extract vibrational frequencies.
        vibs=$(grep "All vibrations are strictly harmonic" -A$lines2 $r | tail -$nov2 | awk '{print $2}' | xargs | tr ' ' ' ')
        # Save info in text file.
        ( echo "$k $ener $zpe $gibbs $dipole $rots $vibs" ) >> Reactant2_conformers.txt
done


# STEP 2.2: Now the transition state conformers.

echo "Name of TRANSITION STATE final conformer optimization"
read TSOPT

# Count the number of reactant conformers
TSnum=$(ls $TSOPT*$suffix.out | wc -l)
echo "$TSnum unique TS Saddle points"

# Write the columns headers for the Transition State  conformer DataFrame.
(echo -n "n Energy ZPE Gibbs Dip A B C" 
for (( i=1; i<=$nov; i++ ))
do
    echo -n " v$i"
done
echo ) > TS_conformers.txt

# Loop over the output files.
k=0
for t in $TSOPT*$suffix.out; do
        k=$((k+1))
        # Exctract DFT energy.
        ener=$(grep 'FINAL SINGLE POINT ENERGY' $t | tail -1 | awk '{printf "%.7f",$5}')
        # Extract Zero-point energy
        zpe=$(grep 'Zero point energy' $t | tail -1 | awk '{print $5}')
        # Extract Gibbs free energy at 298.15 K (for determining most likely TS saddle point)
        gibbs=$(grep "Final Gibbs free energy" $t | tail -1 | awk '{print $6}')
        # Extract dipole moment
        dipole=$(grep "Magnitude (Debye)" $t | awk '{print $4}')
        # Extract rotational constants.
        rots=$(grep "Rotational constants in cm-1:" $t | tail -1 | awk '{print $5,$6,$7}' | xargs | tr ' ' ' ')
        # Extract vibrational frequencies. Note difference from previous loop! The negative frequency is included here.
        vibs=$(grep "Scaling factor for frequencies" -A$TSlines $t | tail -$nov | awk '{print $2}' | xargs | tr ' ' ' ')
        # Save info in text file.
        ( echo "$k $ener $zpe $gibbs $dipole $rots $vibs" ) >> TS_conformers.txt
done

# Step 2.3: The same information for the IRC reactant and product
# ONLY PERFORMED IF TUNNELING CORRECTIONS ARE CHOSEN

if [ "$tunnel" == "y" ]; then 

# Write the columns headers for the Product DataFrame.
(echo -n "n Energy ZPE Gibbs A B C" 
for (( i=1; i<=$nov; i++ ))
do
    echo -n " v$i"
done
echo ) > IRC_Product_conformer.txt

Pener=$(grep "FINAL SINGLE POINT ENERGY" $PwB.out | awk '{print $5}' | tail -1 )
zpe=$(grep 'Zero point energy' $PwB.out | tail -1 | awk '{print $5}')
dipole=$(grep "Magnitude (Debye)" $PwB | awk '{print $4}')
gibbs=$(grep "Final Gibbs free energy" $PwB.out | awk '{print $6}') # This information is strictly speaking not necessary, but it's nice that the indexing stays consistent.
rots=$(grep "Rotational constants in cm-1:" $PwB.out | tail -1 | awk '{print $5,$6,$7}' | xargs | tr ' ' ' ')
vibs=$(grep "All vibrations are strictly harmonic" -A$Plines $PwB.out | tail -$nov | awk '{print $2}' | xargs | tr ' ' ' ')
( echo "0 $Pener $zpe $gibbs $dipole $rots $vibs" ) >> IRC_Product_conformer.txt

# Write the columns headers for the IRC Reactant DataFrame.
(echo -n "n Energy ZPE Gibbs A B C"
for (( i=1; i<=$nov; i++ ))
do
    echo -n " v$i"
done
echo ) > IRC_Reactant_conformer.txt

IRCener=$(grep "FINAL SINGLE POINT ENERGY" $IRCR.out | awk '{print $5}' | tail -1 )
zpe=$(grep 'Zero point energy' $IRCR.out | tail -1 | awk '{print $5}')
dipole=$(grep "Magnitude (Debye)" $IRCR | awk '{print $4}')
gibbs=$(grep "Final Gibbs free energy" $IRCR.out | awk '{print $6}') # This information is strictly speaking not necessary, but it's nice that the indexing stays consistent.
rots=$(grep "Rotational constants in cm-1:" $IRCR.out | tail -1 | awk '{print $5,$6,$7}' | xargs | tr ' ' ' ')
vibs=$(grep "All vibrations are strictly harmonic" -A$Plines $IRCR.out | tail -$nov | awk '{print $2}' | xargs | tr ' ' ' ')
( echo "0 $IRCener $zpe $gibbs $dipole $rots $vibs" ) >> IRC_Reactant_conformer.txt

fi

################################################
# STEP 3: Do all the necessary number crunching.
################################################

echo "Calculate over a range of temperatures? (y/n)"
read Trange
if [ "$Trange" == "y" ]; then
echo "Low T? default 250.0 K"
read lowT
if [ -z "$lowT" ]; then lowT="250.0"; fi

echo "High T? Default 315.0 K"
read highT
if [ -z "$highT" ]; then highT="315.0"; fi

else
lowT="298.0"
highT="298.0"
fi

echo "Constant multiplier for reaction rate (Multiplicity multiplier * TS optical degeneracy)"
read Deg

module load python-data

python $snakepit/MCTSTBimole.py $Trange $lowT $highT $REe1 $REedft1 $REe2 $REedft2 $TSEe $TSEedft $R1mass $R2mass 0 0 0 0 $Deg $tunnel

