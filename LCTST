#!/bin/bash
##############################################################################################
# Script for Single Conformer Transition State Theory Calculations with Temperature Dependence
# by Lauri Franzon
##############################################################################################

##################################################################################################
# Note: These TST scripts are built on the assumption that output files have the naming convention
# PrefixN-DFTsuffix.out or PrefixN-DFTsuffix-CCSD(T)suffix.out
# Where N is an integer. This is crucial for the code's recognition of which file is which.
##################################################################################################

# For other users: Change this variable name to the location of your python scripts.
snakepit="/users/lfranzon/ORCA_Workflow_Scripts/Snakepit"

echo "Your files:"
ls

echo "CCSD(T) file name extension? e.g. DLPNO or F12?"
read ccname

#########################################################################################
# STEP 1: Extract Coupled-Cluster energy corrections from reactant, TS, and Product files.
##########################################################################################

echo "Name of REACTANT Coupled-Cluster output file"
read RCC

# Extract Coupled Cluster energy
REe=$(grep "FINAL SINGLE POINT ENERGY" $RCC.out | awk '{print $5}')

# Extract DFT electronic energy for the same conformer.
REedft=$(grep "FINAL SINGLE POINT ENERGY" ${RCC%-$ccname}.out | awk '{print $5}' | tail -1 )

echo "Name of TRANSITION STATE Coupled-Cluster output file"
read TSCC

# Extract Coupled Cluster energy
TSEe=$(grep "FINAL SINGLE POINT ENERGY" $TSCC.out | awk '{print $5}')

# Extract DFT electronic energy for the same conformer.
TSEedft=$(grep "FINAL SINGLE POINT ENERGY" ${TSCC%-$ccname}.out | awk '{print $5}' | tail -1 )

echo "Name of PRODUCT Coupled-Cluster output file"
read PCC

# Extract Coupled Cluster energy
PEe=$(grep "FINAL SINGLE POINT ENERGY" $PCC.out | awk '{print $5}')

# Extract DFT electronic energy for the same conformer.
PEedft=$(grep "FINAL SINGLE POINT ENERGY" ${PCC%-$ccname}.out | awk '{print $5}' | tail -1 )

echo "Coupled-Cluster Electronic energies extracted."

#####################################################################
#STEP 2: Make a table out of all the necessary reaction coordinate data.
#####################################################################

# Count the number of vibrational modes from a reactant optimization file.
nov=$( grep "total number of vibrations considered is" ${RCC%-$ccname}.out | tail -1 | awk '{print $8}' )
# Number of lines to grep from ORCA vibrational output
let "lines=nov+1"
let "TSlines=nov+7"    # A slightly different frequency extraction command is needed to include the negative frequency.

# Write the columns headers for the Reaction Coordinate DataFrame.
(echo -n "n Energy ZPE Gibbs A B C" 
for (( i=1; i<=$nov; i++ ))
do
    echo -n " v$i"
done
echo ) > Coordinate.txt

# Extrant info from REACTANT. Energy, ZPE, Gibbs free energy, Rotational constants & vibrational frequencies...
zpe=$(grep 'Zero point energy' ${RCC%-$ccname}.out | tail -1 | awk '{print $5}')
gibbs=$(grep "Final Gibbs free energy" ${RCC%-$ccname}.out | awk '{print $6}') # This information is strictly speaking not necessary, but it's nice that the indexing stays consistent.
rots=$(grep "Rotational constants in cm-1:" ${RCC%-$ccname}.out | tail -1 | awk '{print $5,$6,$7}' | xargs | tr ' ' ' ')
vibs=$(grep "All vibrations are strictly harmonic" -A$lines ${RCC%-$ccname}.out | tail -$nov | awk '{print $2}' | xargs | tr ' ' ' ')
# Add to Coordinate file.
( echo "R  $REedft $zpe $gibbs $rots $vibs" ) >> Coordinate.txt

# Extrant info from TRANSITION STATE. Energy, ZPE, Gibbs free energy, Rotational constants & vibrational frequencies... 
zpe=$(grep 'Zero point energy' ${TSCC%-$ccname}.out | tail -1 | awk '{print $5}')
gibbs=$(grep "Final Gibbs free energy" ${TSCC%-$ccname}.out | tail -1 | awk '{print $6}')
rots=$(grep "Rotational constants in cm-1:" ${TSCC%-$ccname}.out | tail -1 | awk '{print $5,$6,$7}' | xargs | tr ' ' ' ')
# Extract vibrational frequencies. Note difference from stable species! The negative frequency is included here.
vibs=$(grep "Scaling factor for frequencies" -A$TSlines ${TSCC%-$ccname}.out | tail -$nov | awk '{print $2}' | xargs | tr ' ' ' ')
# Add to Coordinate file.
( echo "TS $TSEeft $zpe $gibbs $rots $vibs" ) >> Coordinate.txt


# Extrant info from PRODUCT. Energy, ZPE, Gibbs free energy, Rotational constants & vibrational frequencies... 
zpe=$(grep 'Zero point energy' ${PCC%-$ccname}.out | tail -1 | awk '{print $5}')
gibbs=$(grep "Final Gibbs free energy" ${PCC%-$ccname}.out | awk '{print $6}') # This information is strictly speaking not necessary, but it's nice that the indexing stays consistent.
rots=$(grep "Rotational constants in cm-1:" ${PCC%-$ccname}.out | tail -1 | awk '{print $5,$6,$7}' | xargs | tr ' ' ' ')
vibs=$(grep "All vibrations are strictly harmonic" -A$lines ${PCC%-$ccname}.out | tail -$nov | awk '{print $2}' | xargs | tr ' ' ' ')
# Add to Coordinate file.
( echo "P  $PEedft $zpe $gibbs $rots $vibs" ) >> Coordinate.txt

################################################
# STEP 3: Do all the necessary number crunching.
################################################

echo "Calculate over a range of temperatures? (y/n)"
read Trange
if [ "$Trange" == "y" ]; then
echo "Low T? default 250.0 K"
read lowT
if [ -z "$lowT" ]; then lowT="250.0"; fi

echo "High T? Default 315.0 K"
read highT
if [ -z "$highT" ]; then highT="315.0"; fi

fi

echo "Reaction path degeneracy? (Including TS optical symmetry)"
read Deg

echo "Neglect tunneling effects? If so, type NT for no tunneling."
read nt

module load python-data

python $snakepit/LCTSTUnimole.py $Trange $lowT $highT $REe $REedft $TSEe $TSEedft $PEe $Pener $Deg $nt
