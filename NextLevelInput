#!/bin/bash
#Calling command: NextLevelInput name
############################################################################################################################
# A script for generating ORCA input files for all xyz files in the directory. The 'name' command can be used to specify
# a selection of the xyz files in the directory.
#
# Note: Answering 'yes' to the 'Geometry modifier?' question will open a text file which lets you specify the contents of the
# %geom block. The '%geom' and 'end' opening and closing the geom block are auto-generated by the script.
############################################################################################################################

g=$(echo $1)
ls *$g*.xyz > mylist.txt # Make a list of all xyz files with 'name' in the title.

echo "Method?"
read met
echo "Basis set?"
read basis
echo "Keywords?"
read key
echo "Charge and multiplicity?"
read cm
echo "Geometry modifier (Hessian, Constraints, Scan), (y/n)?"
read geom

# Ask if a hess file from a previous calculation should be used.
if [ "$geom" == "y" ];  then
echo "Read Hessian? (y/n)"
read qh
nano input.txt
fi

echo "Number of parallel processes?"
read cores
echo "Memory per core?"
read memcore
echo "Label for filenames?"
read label

# CASSCF-specific output
if [ "$met" == "casscf" ]; then

echo "
%casscf
nel 12
norb 12
mult 1
nroots 1
end

" > cas.txt

nano cas.txt

fi

while [ -s mylist.txt ]	      	      			#while the file is not empty
do
read -r f < mylist.txt					#Reads first line from mylist
NAME=`echo "$f" | cut -d'.' -f1`
sed -i '1d' mylist.txt

if [[ ${NAME: -3} == "trj" ]]; then  # Skip trajectory files auto-generated from geometry optimization jobs.
        continue
fi

if [ "$met" == "casscf" ]; then

( echo "! $basis $key MOREAD

%moinp \"$NAME.gbw\"

%pal
nprocs=$cores
end
"

if [ ! -z "$mem" ]; then
echo "%maxcore $memcore
"
fi

cat cas.txt
if [[ "$geom" == "y" ]];  then
echo "%geom"
cat input.txt
echo "end
"
fi

# If Frequencies were specified (and written last!) in the keyword input, turn Quasi-RRHO off and use simple HO instead.
# Motivation: Better the devil you know.
if [ ${key: -4} == "Freq" ] || [ ${key: -4} == "FREQ" ] ; then
echo "%freq"
echo "QuasiRRHO False"
echo "end
"
fi

echo "* xyz $cm";
tail -n +3 $NAME.xyz;
echo "*" ) > $NAME-$label.inp

else

( echo "!$met $basis $key

%pal
nprocs=$cores
end
"
if [ ! -z "$memcore" ]; then
echo "%maxcore $memcore"
echo ""
fi

if [[ "$geom" == "y" ]];  then
echo "%geom"
cat input.txt

if [[ "$qh" == "y" ]];  then
echo "InHess Read
InHessName \"$NAME.hess\" "
fi
echo "end
"
fi

# If Frequencies were specified (and written last!) in the keyword input, turn Quasi-RRHO off and use simple HO instead.
# Motivation: Better the devil you know.
if [ ${key: -4} == "Freq" ] || [ ${key: -4} == "FREQ" ] ; then
echo "%freq"
echo "QuasiRRHO False"
echo "end
"
fi

echo "* xyz $cm";
tail -n +3 $NAME.xyz;
echo "*" ) > $NAME-$label.inp

fi
done

rm input.txt cas.txt mylist.txt  # Remove unnecessary files
