#!/bin/bash
#Calling command: runGOAT name(.xyz)
############################################################################################################################
# Run GOAT for the specified xyz file.
############################################################################################################################

orcadir="/projappl/kurten/appl_public/orca_6_1_1_linux_x86-64_shared_openmpi418_avx2"
acc="kurten"

echo "Note: Script is written to utilize the shared node local scratch, which has a maximum storage capacity of 20 GB."

g=$(echo $1)

# If no input is given, use the first xyz file in the directory.
if [ -z "$g" ]; then g=$(ls *xyz | head -1 ); fi

echo "Level of theory? Method Basis"
read THEO
echo "Charge and multiplicity?"
read cm
echo "Max energy cutoff?"
read MaxEn
echo "Geometry modifier (Constraints), y/n?"
read geom
if [[ "$geom" == "y" ]];  then
nano input.txt
fi
echo "Time?"
read TIME
echo "Number of parallel processes?"
read cores
echo "Memory per core?"
read memcore
echo "Select the partition: (test or small)"
read queue

# Find the exact name of the file, in case input was simplified.
NAME=`echo "$g.xyz" | cut -d'.' -f1`

( echo "! $THEO GOAT

%pal
nprocs=$cores
end

%maxcore $memcore

%goat
MaxEn $MaxEn
Skipinitialopt True
Align True
end
"

if [[ "$geom" == "y" ]];  then
echo "%geom"
cat input.txt
echo "end
"
fi

echo "* xyz $cm";
tail -n +3 $NAME.xyz;
echo "*" ) > $NAME-Goat.inp

# Nino's project does not have access to Roihu
#echo "Use Nino's project? y/n"
#read Nino
#if [ "$Nino" = "y" ]; then
#acc="project_2006383"
#fi

# Create .job file
echo "#!/bin/bash -l
#SBATCH -J Goat-$NAME
#SBATCH -t $TIME
#SBATCH --ntasks-per-node $cores
#SBATCH --nodes 1
#SBATCH --account=$acc
#SBATCH --mem-per-cpu=$memcore
#SBATCH -p $queue

export ORCADIR=$orcadir
module purge
module load orca/6.1.1

# Utilize the shared nodes' local storage capabilities.
# Note: max capacity is 20 GB.
cp \$SLURM_SUBMIT_DIR/$NAME-Goat.inp \$TMPDIR/
cd \$TMPDIR

\$ORCADIR/orca $NAME-Goat.inp > \$SLURM_SUBMIT_DIR/$NAME-Goat.out

# Return to the submission directory and save the output files.
cd \$SLURM_SUBMIT_DIR
cp -r \$TMPDIR .
mv \$SLURM_JOBID/* .
rmdir \$SLURM_JOBID
seff \$SLURM_JOBID
" > $NAME-Goat.job

sbatch $NAME-Goat.job

rm input.txt

