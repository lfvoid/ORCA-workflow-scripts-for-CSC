#!/bin/bash
#Command: runF12 filename
############################################################################################################
# Generates an input file for a  RI-CCSD(T)-F12 single point energy evaluation and runs it in local scratch.
#############################################################################################################

echo "Roihu currently only has local scratch on the hugemem node, and this script has been written to use it by default."

# For other users: These are the variables you may want to change:
acc="kurten"
orcadir="/projappl/kurten/appl_public/orca_6_1_1_linux_x86-64_shared_openmpi418_avx2"

g=$(echo $1)

echo "Time? (max 36:00:00 on hugememe)"
read TIME
echo "Charge and multiplicity?"
read c_and_m
echo "Number of parallel processes? (128 per node on hugememe)"
read core
echo "Memory per core?"
read memcore
echo "Local disk space?"
read disk

echo "DLPNO approximation? y/n"
read DLPNO
if [ "$DLPNO" = "y" ]; then
cmndline="! UHF DLPNO-CCSD(T)-F12 cc-pVDZ-F12 cc-pVDZ-F12-CABS cc-pVTZ/C TightPNO TightSCF"
else
cmndline="! UHF CCSD(T)-F12/RI cc-pVDZ-F12 cc-pVDZ-F12-CABS cc-pVTZ/C TightSCF"
fi

# Nino's project does not have access to Roihu
#echo "Use Nino's project? y/n"
#read Nino
#if [ "$Nino" = "y" ]; then
#acc="project_2006383"
#fi

ls *$g*.xyz > mylist.txt

while [ -s mylist.txt ]	      	      			#while the file is not empty
do
read -r f < mylist.txt					#Reads first line from mylist
NAME=`echo "$f" | cut -d'.' -f1`
sed -i '1d' mylist.txt

if [[ ${NAME: -3} == "trj" ]]; then  # Skip trajectory files auto-generated from geometry optimization jobs. 
        continue
fi

( echo "$cmndline

%pal
nprocs=$core
end

%maxcore $memcore
"
echo "* xyz $c_and_m";
tail -n +3 $NAME.xyz;
echo "*" ) > $NAME-F12.inp
done

batch=($(ls -1 *F12.inp))

# Create .job file
echo "#!/bin/bash -l
#SBATCH -J $g-F12
#SBATCH -t $TIME
#SBATCH --ntasks-per-node $core
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=$MEM
#SBATCH --nodes 1
#SBATCH --account=$acc
#SBATCH -p hugemem
#SBATCH --gres=nvme:$disk

export ORCADIR=$orcadir
module purge
module load orca/6.1.1

#Set $ORCA_TMPDIR to point to the local disk
export ORCA_TMPDIR=\$LOCAL_SCRATCH
cp \$SLURM_SUBMIT_DIR/*.inp \$ORCA_TMPDIR/
cd \$ORCA_TMPDIR

" > $g-F12.job

for l in ${batch[@]}; do
FILE=`echo "$l" | cut -d'.' -f1`
        echo "\$ORCADIR/orca $FILE.inp > \${SLURM_SUBMIT_DIR}/$FILE.out" >> $g-F12.job
done
echo "seff \$SLURM_JOBID" >> $g-F12.job
echo "cp -r \$ORCA_TMPDIR \$SLURM_SUBMIT_DIR" >> $g-F12.job

sbatch $g-F12.job
rm mylist.txt
